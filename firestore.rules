rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ASHA Alerts Collection: Allow public read/create with strict schema checks, update allowed for status changes
    match /asha_alerts/{alertId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['id', 'severity', 'status', 'timestamp'])
                    && request.resource.data.status in ['pending', 'acknowledged', 'visited'];
      allow update: if request.resource.data.status in ['pending', 'acknowledged', 'visited'];
      allow delete: if false;
    }

    // Users Collection: Allow authenticated users to read/write their own profile doc, allow guest profiles
    match /users/{userId} {
      allow read: if true;
      allow create, update, write: if true;
    }

  }
}

